{
  "root": "root",
  "elements": {
    "root": {
      "type": "Card",
      "props": { "title": "Sign in to your account" },
      "children": ["form"]
    },
    "form": {
      "type": "GridContainer",
      "props": {},
      "children": ["email", "password", "submit", "helper"]
    },
    "email": {
      "type": "Input",
      "props": { "type": "email", "label": "Email address", "placeholder": "you@example.gov", "name": "email" }
    },
    "password": {
      "type": "Input",
      "props": { "type": "password", "label": "Password", "name": "password" }
    },
    "submit": {
      "type": "Button",
      "props": { "variant": "default" },
      "children": ["submitLabel"]
    },
    "submitLabel": {
      "type": "Text",
      "props": { "text": "Sign in" }
    },
    "helper": {
      "type": "Text",
      "props": { "text": "Forgot your password? Contact support.", "size": "sm" }
    }
  }
}
